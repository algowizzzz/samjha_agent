{
  "name": "query_result_evaluator",
  "implementation": "external.tools.parquet_agent.query_result_evaluator.QueryResultEvaluatorTool",
  "description": "Evaluate query results against QuerySpec",
  "version": "2.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "required": ["query_spec", "results_summary", "validation_checks"],
    "properties": {
      "query_spec": {"type": "object"},
      "results_summary": {"type": "object"},
      "validation_checks": {"type": "array"}
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["satisfied", "issues", "notes"],
    "properties": {
      "satisfied": {"type": "boolean"},
      "issues": {"type": "array", "items": {"type": "string"}},
      "notes": {"type": "string"}
    }
    },
  "metadata": {
    "author": "Parquet Agent Team",
    "category": "Evaluation",
    "tags": ["parquet_agent", "evaluation", "results"]
  }
}
