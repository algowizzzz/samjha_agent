{
  "name": "list_dir",
  "implementation": "external.tools.parquet_agent.list_dir.ListDirTool",
  "description": "List files and directories in a domain folder",
  "version": "1.0.0",
  "enabled": true,
  "data_directory": "mock_datawarehouse",
  "inputSchema": {
    "type": "object",
    "required": ["path"],
    "properties": {
      "path": {
        "type": "string",
        "description": "Domain folder path"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["entries"],
    "properties": {
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "path", "type"],
          "properties": {
            "name": {"type": "string"},
            "path": {"type": "string"},
            "type": {"enum": ["file", "dir"]}
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Parquet Agent Team",
    "category": "Data Discovery",
    "tags": ["parquet_agent", "list", "directory"]
  }
}

