{
  "name": "deep_research_agent",
  "implementation": "external.agent.deep_research.deep_research_base_agent.DeepResearchAgentTool",
  "description": "Deep research agent that discovers structured data sources and produces SQL plans plus analytical reasoning.",
  "version": "1.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Natural language research request"
      },
      "session_id": {
        "type": "string",
        "description": "Optional session id"
      },
      "user_id": {
        "type": "string",
        "description": "User identifier"
      }
    },
    "required": ["query"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "final_output": {
        "type": "object",
        "properties": {
          "response": {"type": "string"},
          "analytical_reasoning": {"type": "object"},
          "sql_queries": {"type": "array"}
        }
      }
    }
  }
}
