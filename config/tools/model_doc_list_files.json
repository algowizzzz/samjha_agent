{
  "name": "model_doc_list_files",
  "implementation": "tools.impl.model_doc_list_files_tool.ModelDocListFilesTool",
  "description": "Recursively scan a codebase directory for Python files and return their metadata (paths, sizes, modification times).",
  "version": "1.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "codebase_path": {
        "type": "string",
        "description": "Path to the codebase root directory.",
        "minLength": 1
      },
      "file_extensions": {
        "type": "array",
        "items": {"type": "string"},
        "description": "List of file extensions to include (default: ['.py']).",
        "default": [".py"]
      },
      "exclude_patterns": {
        "type": "array",
        "items": {"type": "string"},
        "description": "List of directory/file patterns to exclude.",
        "default": ["__pycache__", "*.pyc", ".git", ".venv", "venv", ".env"]
      }
    },
    "required": ["codebase_path"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "codebase_path": {"type": "string"},
      "file_count": {"type": "integer"},
      "files": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "file_path": {"type": "string"},
            "relative_path": {"type": "string"},
            "file_size": {"type": "integer"},
            "modified_time": {"type": "string"},
            "extension": {"type": "string"}
          }
        }
      }
    },
    "required": ["codebase_path", "file_count", "files"]
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "category": "Model Documentation",
    "tags": ["model-doc", "codebase", "files", "discovery"],
    "note": "Scans a directory recursively for Python files. Use this as the first step in codebase discovery."
  }
}

