def node_decide_chunking_strategy(state: AgentState) -> AgentState:
    """
    Reads:
      - state["file_metadata"]
      - state["config"]["chunking"]
    Writes:
      - state["chunking_decision"]
      - state["file_metadata"]["chunking"]
      - state["last_node"], state["logs"]
    """
    file_metadata = cast(dict, state["file_metadata"])
    chunk_cfg = cast(dict, state["config"].get("chunking", {}))

    result = call_mcp("decide_chunking_strategy", {
        "file_metadata": file_metadata,
        "config": {
            "page_threshold": chunk_cfg.get("page_threshold", 50),
            "context_aware_level": chunk_cfg.get("context_aware_level", "h2"),
            "force_chunk": chunk_cfg.get("force_chunk"),
        },
    })

    state["chunking_decision"] = result

    # Mirror into file_metadata
    file_metadata = deepcopy(file_metadata)
    file_metadata["chunking"] = {
        "should_chunk": result["should_chunk"],
        "strategy": result["strategy"],
        "reason": result["reason"],
        "max_chunk_tokens": chunk_cfg.get("max_chunk_tokens"),
    }
    state["file_metadata"] = file_metadata

    state.setdefault("logs", []).append(
        f"decide_chunking_strategy: {result['strategy']} should_chunk={result['should_chunk']}"
    )
    state["last_node"] = "decide_chunking_strategy"
    return state
```

