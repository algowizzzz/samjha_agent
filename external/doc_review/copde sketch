## 4. LLM nodes (pure LangGraph, no MCP)

### 4.1 `node_heading_mapping_llm`

```python
from langchain_core.messages import SystemMessage, HumanMessage
from langgraph.types import Send

# replace with your actual LLM client
from .llm_client import llm_call_json


def node_heading_mapping_llm(state: AgentState) -> AgentState:
    """
    Reads:
      - state["template"]
      - state["index"]["sections"]
    Writes:
      - state["index"]["sections"][i]["template_mapping"]
      - state["index"]["sections"][i]["status"]
      - state["last_node"], state["logs"]
    """
    template = cast(dict, state["template"])
    index = cast(dict, state["index"])
    sections = cast(list, index.get("sections", []))

    # Prepare payload for the model
    model_input_sections = [
        {
            "file_section_id": s["file_section_id"],
            "heading_text": s["heading_text_original"],
            "heading_path": s.get("heading_path", []),
        }
        for s in sections
    ]

    system_prompt = (
        "You map document sections to a predefined outline template. "
        "For each section, choose one template section id or return `unmapped`."
    )

    user_payload = {
        "template": template,
        "sections": model_input_sections,
    }

    mappings = llm_call_json(
        system=system_prompt,
        user=user_payload,
        response_schema={
            "type": "array",
            "items": {
                "type": "object",
                "required": ["file_section_id", "mapped"],
                "properties": {
                    "file_section_id": {"type": "string"},
                    "mapped": {"type": "boolean"},
                    "template_section_id": {"type": ["string", "null"]},
                    "template_path": {
                        "type": ["array", "null"],
                        "items": {"type": "string"},
                    },
                    "confidence": {"type": ["number", "null"]},
                },
            },
        }
    )

    mapping_by_id = {m["file_section_id"]: m for m in mappings}

    # Update index.sections in place
    for s in sections:
        sid = s["file_section_id"]
        m = mapping_by_id.get(sid)
        if not m:
            continue
        tm = s.get("template_mapping", {})
        tm.update({
            "mapped": m["mapped"],
            "template_section_id": m.get("template_section_id"),
            "template_path": m.get("template_path"),
            "confidence": m.get("confidence"),
        })
        s["template_mapping"] = tm
        s["status"] = "mapped" if m["mapped"] else "unmapped"

    index["sections"] = sections
    state["index"] = index

    state.setdefault("logs", []).append(
        f"heading_mapping_llm: mapped={sum(1 for s in sections if s.get('status')=='mapped')}"
    )
    state["last_node"] = "heading_mapping_llm"
    return state
```

