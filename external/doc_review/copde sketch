### 4.3 `node_relevancy_scoring_llm`

```python
def node_relevancy_scoring_llm(state: AgentState) -> AgentState:
    """
    Reads:
      - state["index"]["sections"] (status == 'unmapped')
      - state["chunks"] (for excerpts)
    Writes:
      - state["index"]["sections"][i]["relevancy_score_if_unmapped"]
      - state["index"]["sections"][i]["template_mapping"]["relevancy_score"]
      - state["last_node"], state["logs"]
    """
    index = cast(dict, state["index"])
    sections = cast(list, index.get("sections", []))
    chunks = cast(list, state.get("chunks", []))
    chunk_by_id = {c["chunk_id"]: c for c in chunks}

    unmapped = [s for s in sections if s.get("status") == "unmapped"]

    payload_sections = []
    for s in unmapped:
        chunk = chunk_by_id.get(s["chunk_id"], {})
        text = chunk.get("text", "")
        excerpt = text[:1000]  # simple truncation
        payload_sections.append({
            "file_section_id": s["file_section_id"],
            "heading_text": s["heading_text_original"],
            "content_excerpt": excerpt,
        })

    system_prompt = (
        "You rate how relevant an unmapped section is to the main document. "
        "Return a score 0-1 and a rough category."
    )

    scores = llm_call_json(
        system=system_prompt,
        user={"sections": payload_sections},
        response_schema={
            "type": "array",
            "items": {
                "type": "object",
                "required": ["file_section_id", "relevancy_score"],
                "properties": {
                    "file_section_id": {"type": "string"},
                    "relevancy_score": {"type": "number"},
                    "category": {
                        "type": "string",
                        "enum": ["maybe_append", "low_value", "append_anyway"]
                    },
                },
            },
        },
    )

    score_by_id = {s["file_section_id"]: s for s in scores}

    for s in sections:
        sid = s["file_section_id"]
        sc = score_by_id.get(sid)
        if not sc:
            continue
        s["relevancy_score_if_unmapped"] = sc["relevancy_score"]
        tm = s.get("template_mapping", {})
        tm["relevancy_score"] = sc["relevancy_score"]
        s["template_mapping"] = tm

    index["sections"] = sections
    state["index"] = index

    state.setdefault("logs", []).append(
        f"relevancy_scoring_llm: scored={len(score_by_id)}"
    )
    state["last_node"] = "relevancy_scoring_llm"
    return state
```

