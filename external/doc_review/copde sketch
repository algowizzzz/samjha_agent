def node_title_improver_llm(state: AgentState) -> AgentState:
    """
    Reads:
      - state["index"]["sections"] (only mapped ones)
      - optionally excerpts from state["chunks"]
    Writes:
      - state["index"]["sections"][i]["heading_text_improved"]
      - state["last_node"], state["logs"]
    """
    index = cast(dict, state["index"])
    sections = cast(list, index.get("sections", []))

    mapped_sections = [
        s for s in sections
        if s.get("status") == "mapped"
    ]

    # Prepare model input
    model_sections = []
    for s in mapped_sections:
        model_sections.append({
            "file_section_id": s["file_section_id"],
            "heading_text_original": s["heading_text_original"],
            "template_section_title": s["template_mapping"].get("template_section_id"),
            # you can add a short content excerpt from chunks if needed
        })

    system_prompt = (
        "You rewrite section titles for clarity and professionalism. "
        "Return concise headings, same language, JSON only."
    )

    improvements = llm_call_json(
        system=system_prompt,
        user={"sections": model_sections},
        response_schema={
            "type": "array",
            "items": {
                "type": "object",
                "required": ["file_section_id", "heading_text_improved"],
                "properties": {
                    "file_section_id": {"type": "string"},
                    "heading_text_improved": {"type": "string"},
                },
            },
        },
    )

    imp_by_id = {i["file_section_id"]: i["heading_text_improved"] for i in improvements}

    for s in sections:
        sid = s["file_section_id"]
        if sid in imp_by_id:
            s["heading_text_improved"] = imp_by_id[sid]

    index["sections"] = sections
    state["index"] = index

    state.setdefault("logs", []).append(
        f"title_improver_llm: improved={len(imp_by_id)}"
    )
    state["last_node"] = "title_improver_llm"
    return state
