### 4.4 `node_second_pass_mapping_llm`

```python
def node_second_pass_mapping_llm(state: AgentState) -> AgentState:
    """
    Reads:
      - state["template"]
      - state["index"]["sections"] (with relevancy scores)
    Writes:
      - state["index"]["sections"][i]["template_mapping"] (for some previously unmapped)
      - state["index"]["sections"][i]["status"] (e.g., 'appended_late')
      - state["last_node"], state["logs"]
    """
    template = cast(dict, state["template"])
    index = cast(dict, state["index"])
    sections = cast(list, index.get("sections", []))

    candidates = [
        s for s in sections
        if s.get("status") == "unmapped"
        and (s.get("relevancy_score_if_unmapped") or 0) >= 0.4
    ]

    payload_sections = [
        {
            "file_section_id": s["file_section_id"],
            "heading_text": s["heading_text_original"],
            "relevancy_score": s.get("relevancy_score_if_unmapped", 0),
        }
        for s in candidates
    ]

    system_prompt = (
        "You get a subset of relevant but unmapped sections and must decide if they "
        "can be matched to remaining template sections."
    )

    mappings = llm_call_json(
        system=system_prompt,
        user={"template": template, "sections": payload_sections},
        response_schema={
            "type": "array",
            "items": {
                "type": "object",
                "required": ["file_section_id", "mapped"],
                "properties": {
                    "file_section_id": {"type": "string"},
                    "mapped": {"type": "boolean"},
                    "template_section_id": {"type": ["string", "null"]},
                    "status": {
                        "type": ["string", "null"],
                        "enum": ["appended_late", "unmapped"]
                    },
                },
            },
        },
    )

    by_id = {m["file_section_id"]: m for m in mappings}

    for s in sections:
        sid = s["file_section_id"]
        m = by_id.get(sid)
        if not m:
            continue
        tm = s.get("template_mapping", {})
        if m["mapped"]:
            tm["mapped"] = True
            tm["template_section_id"] = m.get("template_section_id")
            s["status"] = "appended_late"
        else:
            s["status"] = "unmapped"
        s["template_mapping"] = tm

    index["sections"] = sections
    state["index"] = index

    state.setdefault("logs", []).append("second_pass_mapping_llm: applied")
    state["last_node"] = "second_pass_mapping_llm"
    return state
```

