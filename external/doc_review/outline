## 4. Config surface (what you can parameterise)

You can centralise all knobs:

```jsonc
{
  "ingestion": {
    "supported_types": ["pdf", "docx", "pptx", "md"]
  },
  "chunking": {
    "page_threshold": 50,
    "max_chunk_tokens": 1500,
    "default_strategy": "by_h2",
    "context_aware_level": "h2",
    "force_chunk": null       // true | false | null
  },
  "template": {
    "template_id": "limits_guide_v1",
    "toc_level": "h2",
    "append_unmapped_section_heading": "Additional Sections"
  },
  "llm": {
    "model": "gpt-4.1",
    "temperature": 0.2,
    "max_tokens": 800
  },
  "ui": {
    "show_ai_title_highlight": true,
    "show_ai_comments": true
  }
}
```

