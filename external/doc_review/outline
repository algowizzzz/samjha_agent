## 2. Core data contracts

You’ll want these as shared types across tools/nodes (e.g., Pydantic models / TypedDicts).

### 2.1. FileMetadata

Per original file:

```jsonc
{
  "file_id": "string",               // internal id for original file
  "source_path": "string",
  "md_file_id": "string",            // id/path of the converted markdown
  "images": [
    {
      "image_id": "string",
      "path": "/images/<file_id>/<image_name>.png",
      "page_number": 3,
      "caption": "optional"
    }
  ],
  "page_count": 12,
  "word_count": 3450,
  "heading_levels": ["h1", "h2", "h3"], // detected in the Markdown
  "chunking": {
    "should_chunk": true,
    "reason": "page_count>50",        // or "config.force_chunk"
    "strategy": "by_h2",              // none | by_page | by_h1 | by_h2 | by_h3 | hybrid
    "max_chunk_tokens": 1500
  },
  "stats": {
    "created_at": "ISO8601",
    "ingestion_version": "v1"
  }
}
```

### 2.2. ChunkMetadata

Per chunk/section:

```jsonc
{
  "chunk_id": "string",
  "file_id": "string",
  "order": 1,                          // global order within file
  "start_page": 1,
  "end_page": 2,
  "start_heading_level": "h2",
  "start_heading_text": "Current Limits Overview",
  "heading_path": [                    // breadcrumb path
    { "level": "h1", "text": "Executive Summary" },
    { "level": "h2", "text": "Current Limits Overview" }
  ],
  "chunking_strategy": "by_h2",
  "token_count": 890,
  "template_mapping": {
    "mapped": false,
    "template_id": null,
    "template_path": null,
    "title_improvement": null,
    "relevancy_score": null
  }
}
```

